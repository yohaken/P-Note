rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // App gate is a local PIN; cloud sync uses Firebase Auth (anonymous or Google).
    function isSignedIn() {
      return request.auth != null;
    }

    // Personal notes payload (client SDK writes here directly).
    match /spaces/{spaceId} {
      allow read, write: if isSignedIn();
    }

    // TellTea login tickets (existing helper page) — signed-in only.
    match /loginTickets/{ticketId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
