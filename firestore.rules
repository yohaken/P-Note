rules_version = '2';
// SHARED RULES for Firebase project mynote-f1bbc.
// This exact file must be identical in: p-note, myApps/iRich iLucky, myApps/TL-Chart.
// Any deploy of firestore:rules from one repo replaces the rules for ALL apps.
service cloud.firestore {
  match /databases/{database}/documents {
    // App gate is a local PIN; cloud sync uses Firebase Auth (anonymous or Google).
    function isSignedIn() {
      return request.auth != null;
    }

    function isPnoteOwner() {
      return request.auth != null
        && (request.auth.uid == 'pnote-owner'
          || (request.auth.token.email == 'yohaken@gmail.com'
            && request.auth.token.email_verified == true));
    }

    // P-Note: personal notes payload (client SDK writes here directly).
    match /spaces/{spaceId} {
      allow read: if isPnoteOwner();
      // create: owner only (clockAt merge on a missing doc must succeed).
      // update: clock-only merge OR full payload with version (hasOnly on the
      // merged result would reject clockAt writes when legacy keys exist).
      allow create: if isPnoteOwner();
      allow update: if isPnoteOwner() && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clockAt', 'updatedAt'])
        || (request.resource.data.keys().hasOnly([
              'version','updatedAt','tags','notes','workspaces','notepads',
              'calorie','homePins','homePinsAt','deletions','settingsSync','clockAt'
            ])
            && request.resource.data.version is number)
      );
    }

    // P-Note / TellTea login tickets — signed-in only.
    match /loginTickets/{ticketId} {
      allow get, create, update, delete: if isSignedIn();
      allow list: if false;
    }

    // iRich iLucky vault — doc id = sha256("irich:"+accessCode)[:32]
    match /irichIlucky/{docId} {
      allow read: if docId == '9bdec800cbc33f09bfe2e362c324cf57';
      allow create, update: if docId == '9bdec800cbc33f09bfe2e362c324cf57'
        && request.resource.data.keys().hasOnly(['state', 'updatedAt', 'version'])
        && request.resource.data.state is map
        && request.resource.data.updatedAt is string
        && request.resource.data.version is string;
      allow delete: if false;
    }

    // TL-Chart device unlock — cloud-first remember (phone allowlist)
    // doc id = opaque device UUID from the browser
    match /tlChartDevices/{deviceId} {
      allow read: if true;
      allow create, update: if request.resource.data.phoneE164 == '+66884818817'
        && request.resource.data.remember == true
        && request.resource.data.app == 'tl-chart'
        && request.resource.data.unlockedAt is string;
      allow delete: if false;
    }

    // TL-Chart AI keys — cloud-first (DeepSeek etc.)
    // RISK (documented, intentionally unchanged): write stays unauthenticated so
    // TL-Chart's browser cloud-first path keeps working. Read is owner-only;
    // rotate the DeepSeek key on ship. Server path uses a service account.
    match /tlChartSecrets/{docId} {
      allow read: if isPnoteOwner() && docId == 'ai';
      allow create, update: if docId == 'ai'
        && request.resource.data.app == 'tl-chart'
        && request.resource.data.ownerPhone == '+66884818817'
        && request.resource.data.deepseekApiKey is string
        && request.resource.data.deepseekModel is string
        && request.resource.data.deepseekEnabled is bool;
      allow delete: if false;
    }

    // TL-Chart EN→TH headline / summary cache — never re-translate
    match /tlChartI18n/{hash} {
      allow read: if true;
      allow create, update: if request.resource.data.app == 'tl-chart'
        && request.resource.data.source is string
        && (
          request.resource.data.th is string
          || request.resource.data.summaryTh is string
        );
      allow delete: if false;
    }

    // Toto List checklist app — doc id = long random sync key; no listing
    match /totoLists/{key} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'yohaken@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // LED KKU Tracker (site led-kku-app) — owner only
    function isLedOwner() {
      return request.auth != null
        && request.auth.token.email == 'yohaken@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /led_properties/{id} { allow read, write: if isLedOwner(); }
    match /led_images/{id} { allow read, write: if isLedOwner(); }
    match /led_deeds/{id} { allow read, write: if isLedOwner(); }
    match /led_notes/{id} { allow read, write: if isLedOwner(); }

    // Easy IPO (site easy-ipo-app) — public read, owner write (Google sign-in)
    function isEasyIpoOwner() {
      return request.auth != null
        && request.auth.token.email == 'yohaken@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /easyipo_ipos/{id} { allow read: if true; allow write: if isEasyIpoOwner(); }
    match /easyipo_tracking/{id} { allow read, write: if isEasyIpoOwner(); }
    match /easyipo_requests/{id} { allow read, write: if isEasyIpoOwner(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
